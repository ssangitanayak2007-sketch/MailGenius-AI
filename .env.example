# ==============================================================================
# MailGen AI - Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Required for AI generation)
# Obtain your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Preferred Gemini Model (Optional, defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
